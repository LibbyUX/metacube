{
  "name": "metacube",
  "version": "1.0.0",
  "description": "Interactive 3D cube visualization for categorical tabular data.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --test tests/data-model.test.mjs",
    "test:embed": "node tests/embed-import.test.mjs",
    "typecheck": "tsc --noEmit",
    "export:index": "SF_ENTRY=index vite build --outDir dist-index"
  },
  "keywords": [
    "data-visualization",
    "three.js"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/d3-color": "^3.1.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-scale-chromatic": "^3.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "d3-color": "^3.1.0",
    "d3-hierarchy": "^3.1.2",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "js-yaml": "^4.1.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/papaparse": "^5.3.16",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
